{
  "name": "days",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/compile-story.ts --check && node scripts/stamp.ts && vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:lane": "pnpm lint && pnpm typecheck",
    "story": "node scripts/compile-story.ts",
    "deploy": "node scripts/deploy.ts"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.8.1",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.5.7.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.24.tgz",
    "inkjs": "2.4.0",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
